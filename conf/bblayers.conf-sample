# POKY_BBLAYERS_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/poky/meta \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/poky/meta-poky \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-openembedded/meta-oe \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-openembedded/meta-networking \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-openembedded/meta-python \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-qt5 \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-ti/meta-ti-bsp \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-ti/meta-ti-extras \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-arm/meta-arm \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-arm/meta-arm-bsp \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-arm/meta-arm-toolchain \
  /media/junske/yocto/Yocto/poky-kirkstone_bbb/meta-jsd \
  "
# /media/junske/yocto/Yocto/poky-kirkstone_bbb/poky/meta-yocto-bsp \
#

