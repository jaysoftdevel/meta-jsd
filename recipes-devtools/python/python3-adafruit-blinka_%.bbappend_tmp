SRCREV = "706e5f8abca75dc3939a4e3464e3f655de04af58"
LIC_FILES_CHKSUM = "file://LICENSE;md5=fccd531dce4b989c05173925f0bbb76c"

inherit setuptools3
RDEPENDS:${PN} = "glibc"
INSANE_SKIP += "file-rdeps"
INSANE_SKIP += "arch"
do_install:append() {
    # Remove precompiled binaries for other platforms
    find ${D}${PYTHON_SITEPACKAGES_DIR} -type f \( -name "libgpiod_pulsein" -o -name "libgpiod_pulsein64" \) ! -name "bcm*" -exec rm -f {} \;
    
    # Install Python modules
    install -d ${D}${PYTHON_SITEPACKAGES_DIR}/adafruit_blinka
    cp -r ${S}/src/adafruit_blinka/* ${D}${PYTHON_SITEPACKAGES_DIR}/adafruit_blinka/

    # Install Raspberry Pi-specific files (bcm283x)
    install -d ${D}${PYTHON_SITEPACKAGES_DIR}/adafruit_blinka/microcontroller
    cp -r ${S}/src/adafruit_blinka/microcontroller/* ${D}${PYTHON_SITEPACKAGES_DIR}/adafruit_blinka/microcontroller/
}
