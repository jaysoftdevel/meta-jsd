[Unit]
Description=Start runtimeServer Python script at boot
After=network.target ntpd.service
Requires=network.target ntpd.service

[Service]
ExecStart=/usr/bin/python3 /var/www/html/runtimeServer.py
WorkingDirectory=/var/www/html
User=root
Group=root
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# --- High Priority Settings ---
Nice=-10                          # Lower nice value = higher priority
CPUSchedulingPolicy=rr           # Or "fifo" (real-time)
CPUSchedulingPriority=20         # 1–99 (only for real-time policies)

# Optional: pin to a CPU core for determinism
# CPUAffinity=1                  # Pin to CPU core 1

# Optional: increase allowed real-time runtime (needed for RT policies)
LimitRTPRIO=99
LimitMEMLOCK=infinity
LimitNICE=-20

[Install]
WantedBy=multi-user.target
