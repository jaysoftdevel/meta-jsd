[Unit]
Description=Start runtimeServer Python script at boot
After=network-online.target ntpd.service
Requires=network-online.target ntpd.service

[Service]
ExecStart=/usr/bin/python3 /var/www/html/runtimeServer.py
WorkingDirectory=/var/www/html
User=root
Group=root
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
